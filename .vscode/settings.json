{
  // The CLI and the registry are plain ESM run by node: no build step, no
  // bundler. These settings only affect this workspace.
  "files.exclude": {
    "**/node_modules": true,
    ".vscode/debug-registry-data": true,
    ".vscode/debug-bevararc": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/package-lock.json": true,
    "packages/cli/src/lib/formats.js": false
  },
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "debug.javascript.terminalOptions": {
    "skipFiles": ["<node_internals>/**"],
    "autoAttachChildProcesses": true
  },
  "files.associations": { "*.bevararc": "json", "bevara.json": "json", "bevara-lock.json": "json" }
}
